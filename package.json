{
  "name": "ai-platform-operations",
  "version": "1.0.0",
  "private": true,
  "description": "AI Platform Operations & Reliability Orchestrator",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
