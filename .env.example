# SQLite for zero-friction local demo. Docker Compose still ships PostgreSQL
# for a production-shaped setup; switch the Prisma provider if you use it.
DATABASE_URL="file:./dev.db"

# Application
NEXT_PUBLIC_APP_NAME="AI Operations"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_MODE="true"

# Auth abstraction (portfolio demo uses a local operator session)
DEMO_OPERATOR_EMAIL="maya.chen@example.com"
DEMO_OPERATOR_ROLE="admin"

# Webhook signing secret used to validate inbound n8n / vendor callbacks.
WEBHOOK_SECRET="replace-with-a-long-random-string"

# Optional live connectors. Leave empty to use built-in connectors.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
N8N_BASE_URL="http://localhost:5678"
N8N_API_KEY=""

# Rate limiting
API_RATE_LIMIT_PER_MINUTE="120"
